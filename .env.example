NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_MODE=embedded
DATABASE_PATH=./.data/postgres
# npm run setup generates these in .env without printing them.
DATA_ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=
ALLOWED_ORIGINS=http://localhost:8081
PUBLIC_APP_URL=http://localhost:8081
BILLING_PROVIDER=disabled
OTP_PROVIDER=development
OTP_PHONE_PREFIXES=+91
OTP_DAILY_CAP=500
AUDIO_ENABLED=false
OPENAI_API_KEY=
AUDIO_DAILY_CAP=1000
# See .env.production.example for provider, email, PostgreSQL and TLS settings.
