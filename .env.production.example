NODE_ENV=production
HOST=127.0.0.1
PORT=4000
DATABASE_MODE=postgres
DATABASE_URL=postgresql://pulse_runtime:REPLACE@db.example.com:5432/cricket_pulse
DB_CA_FILE=/run/secrets/postgres-ca.pem
# Generate separate 32-byte hex keys; inject from a secret manager.
DATA_ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=
PUBLIC_APP_URL=https://app.example.com
ALLOWED_ORIGINS=https://app.example.com
# Trust only the actual reverse proxy. Never use true or 0.0.0.0/0.
TRUST_PROXY_CIDRS=127.0.0.1/32
# Alternatively terminate TLS in Node with these files:
# TLS_CERT_FILE=/run/secrets/api-cert.pem
# TLS_KEY_FILE=/run/secrets/api-key.pem
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
BILLING_PROVIDER=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PLUS_MONTHLY=
RAZORPAY_PLAN_PLUS_YEARLY=
CRICKET_LICENSE_CONFIRMED=false
CRICKET_FEED_URL=
CRICKET_FEED_HOST=
CRICKET_FEED_TOKEN=
CRICKET_WEBHOOK_SECRET=
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_PHONE_PREFIXES=+91
OTP_DAILY_CAP=500
# Enable only after confirming commentary-to-speech rights and provider budget.
AUDIO_ENABLED=false
OPENAI_API_KEY=
AUDIO_DAILY_CAP=1000
